#version 460
#extension GL_EXT_ray_tracing : require

// --ray-tracing: one ray per pixel of a 256x256 storage image, straight down +z through a
// triangle the scene's single instance holds.
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D target;

layout(location = 0) rayPayloadEXT vec3 color;

void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    color = vec3(0.0);
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, vec3(uv.x, -uv.y, -1.0), 0.001, vec3(0.0, 0.0, 1.0), 10.0, 0);
    imageStore(target, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
