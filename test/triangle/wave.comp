#version 450
// A compute stage for the test application: fills a "wave" storage buffer every frame, so
// captures contain dispatches (a compute pass for Profile passes) and a compute pipeline.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Wave {
    float values[];
} wave;

layout(push_constant) uniform Push {
    float time;
    uint count;
} pc;

// Shared memory and a loop with a loop-invariant term: what the inspector's shader analysis
// reports (workgroup memory size, loop-invariant computation).
shared float scratch[64];

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    float bias = 0.0;
    for (uint k = 0u; k < 4u; ++k) bias += cos(pc.time) * 0.001;
    scratch[gl_LocalInvocationID.x] = bias;
    barrier();
    wave.values[i] = sin(pc.time + float(i) * 0.05) + scratch[(gl_LocalInvocationID.x + 1u) % 64u];
}
