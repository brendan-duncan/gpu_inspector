#version 450
// A compute stage for the test application: fills a "wave" storage buffer every frame, so
// captures contain dispatches (a compute pass for Profile passes) and a compute pipeline.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Wave {
    float values[];
} wave;

layout(push_constant) uniform Push {
    float time;
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    wave.values[i] = sin(pc.time + float(i) * 0.05);
}
